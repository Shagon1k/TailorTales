# Google Analytics — prod only; leave unset in dev and UAT
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Sentry — error tracking (disabled in dev; enabled on UAT/prod)
NEXT_PUBLIC_SENTRY_ENABLED=false
# NEXT_PUBLIC_SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="uat"   # or "production"
# SENTRY_AUTH_TOKEN=""                   # build-time only: source map uploads

# Canonical public origin — used by sitemap, robots, canonical/hreflang tags and OG URLs.
# Non-www, no trailing slash. Per env: https://tailortales.app (prod), https://uat.tailortales.app (UAT).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

NEXT_PUBLIC_BACKEND_URL="http://localhost:3001"
NEXT_PUBLIC_STORAGE_URL="http://localhost:9000"

# Paddle.js overlay checkout — leave empty until the Paddle sandbox/live catalog exists
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
NEXT_PUBLIC_PADDLE_ENV="sandbox"
