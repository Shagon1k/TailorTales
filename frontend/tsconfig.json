{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["dom", "dom.iterable", "esnext"],
        "jsx": "react-jsx",
        "noEmit": true,
        "allowJs": true,
        "isolatedModules": true,
        "types": ["node", "vitest/globals"],
        "paths": {
            "@/*": ["./src/*"]
        },
        "plugins": [{ "name": "next" }]
    },
    "include": [
        "next-env.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        ".next/types/**/*.ts",
        "test-setup.ts"
    ],
    "exclude": ["node_modules"]
}
