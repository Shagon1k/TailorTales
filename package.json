{
  "name": "tailortales",
  "version": "0.0.1",
  "private": true,
  "description": "Personalized AI-generated storybooks & comics for curious kids",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./backend\" --filter \"./frontend\" dev",
    "build": "pnpm --filter \"./backend\" build && pnpm --filter \"./frontend\" build",
    "lint": "pnpm --filter \"./backend\" --filter \"./frontend\" lint",
    "test": "pnpm --filter \"./backend\" --filter \"./frontend\" test"
  }
}
