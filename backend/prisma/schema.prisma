generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum Language {
  EN
  RU
}

enum StoryType {
  BOOK
  COMIC
}

enum StoryStatus {
  DRAFT
  QUEUED
  GENERATING
  COMPLETED
  FAILED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  googleId  String   @unique
  name      String
  avatarUrl String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children          Child[]
  stories           Story[]
  createdTemplates  Template[]
}

model Child {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  birthdate DateTime
  gender    Gender
  interests String[]
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stories Story[]
}

model ArtStyle {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  thumbnailUrl String
  promptPrefix String
  isActive     Boolean  @default(true)
  order        Int
  createdAt    DateTime @default(now())

  stories Story[]
}

model Story {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId    String
  child      Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  type       StoryType
  status     StoryStatus @default(DRAFT)
  templateId String?
  template   Template?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  question   String
  pageCount  Int
  artStyleId String
  artStyle   ArtStyle    @relation(fields: [artStyleId], references: [id])
  language   Language
  title         String?
  isPublic      Boolean     @default(false)
  coverImageKey String?
  pdfKey        String?
  createdAt     DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  pages Page[]
}

model Page {
  id            String  @id @default(cuid())
  storyId       String
  story         Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  order         Int
  chapterTitle  String?
  text          String?
  illustrations Json
  layout        String?

  @@unique([storyId, order])
}

model Template {
  id              String    @id @default(cuid())
  name            String
  description     String
  type            StoryType
  systemPrompt     String
  coverImageKey    String
  previewPageKeys  String[]
  createdById     String
  createdBy       User      @relation(fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stories Story[]
}
