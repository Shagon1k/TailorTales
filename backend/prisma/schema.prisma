generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum Language {
  EN
  RU
  DE
}

enum StoryType {
  BOOK
  COMIC
}

// Optional story flavour knobs — each maps to a prompt fragment injected at Planning.
enum StoryGenre {
  FAIRY_TALE
  BEDTIME
  EDUCATIONAL
  ADVENTURE
}

enum WritingStyle {
  POETIC
  SIMPLE
  IMAGINATIVE
}

enum StoryStatus {
  DRAFT
  QUEUED
  GENERATING
  COMPLETED
  FAILED
}

enum JobType {
  GENERATION
  REGENERATION
}

enum JobStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
}

enum NotificationType {
  STORY_COMPLETED
  STORY_FAILED
  PAYMENT_FAILED
  SUBSCRIPTION_CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum CharacterSource {
  IMAGINED
  QUIZ
  PHOTO
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  googleId  String   @unique
  name      String
  avatarUrl String?
  role      Role     @default(USER)
  /** Set when an admin suspends the account; blocks auth while non-null. */
  suspendedAt DateTime?
  /** Partial per-event channel toggles — null means all defaults (everything on). */
  notificationPreferences Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children          Child[]
  stories           Story[]
  characters        Character[]
  createdBlueprints StoryBlueprint[]
  notifications     Notification[]
  subscription      Subscription?
  ratings           Rating[]
}

model PricingTier {
  id              String  @id @default(cuid())
  name            String  @unique
  /** Paddle catalog ids — null on the free tier (no Paddle product behind it). */
  paddleProductId String?
  /** Paddle.js checkout opens with a PRICE id, not a product id. */
  paddlePriceId   String?
  /** Euro cents (0 / 500 / 1000). Format to € only at the frontend edge. */
  priceMonthly          Int
  pagesPerMonth         Int
  regenerationsPerMonth Int
  characterGenerationsPerMonth Int
  /** Null = unlimited. */
  childrenLimit Int?
  /** Null = unlimited. */
  charactersLimit Int?
  /** Null = retained forever. */
  retentionDays Int?
  watermark     Boolean @default(false)
  /** Pricing-page sort order. */
  order         Int

  subscriptions Subscription[]
}

model Subscription {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pricingTierId String
  pricingTier   PricingTier @relation(fields: [pricingTierId], references: [id])

  /** Null on the free tier. */
  paddleSubscriptionId String? @unique
  /** Kept after cancel — billing portal and invoice history need it. */
  paddleCustomerId     String?

  status            SubscriptionStatus @default(ACTIVE)
  /** Paddle scheduled cancellation — drives the "cancels on <date>" UI. */
  cancelAtPeriodEnd Boolean            @default(false)
  /** Null on the free tier. */
  currentPeriodEnd  DateTime?

  pagesUsed         Int @default(0)
  regenerationsUsed Int @default(0)
  characterGenerationsUsed Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Child {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  birthdate DateTime
  gender    Gender
  interests String[]
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stories    Story[]
  characters Character[]
}

model ArtStyle {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  /** S3 key of the generated sample thumbnail. Signed at serve time — DB never stores URLs. */
  thumbnailKey String?
  promptPrefix String
  isActive     Boolean  @default(true)
  order        Int
  createdAt    DateTime @default(now())

  stories Story[]
}

model Story {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId    String
  child      Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  type       StoryType
  status     StoryStatus @default(DRAFT)
  blueprintId String?
  blueprint   StoryBlueprint? @relation(fields: [blueprintId], references: [id], onDelete: SetNull)
  question   String
  pageCount  Int
  artStyleId String
  artStyle   ArtStyle    @relation(fields: [artStyleId], references: [id])
  language   Language
  genre        StoryGenre?
  writingStyle WritingStyle?
  title         String?
  styleAnchor   String?
  characterId   String?
  character     Character?  @relation(fields: [characterId], references: [id], onDelete: SetNull)
  isPublic      Boolean     @default(false)
  coverImageKey String?
  pdfKey        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  pages   Page[]
  jobs    Job[]
  ratings Rating[]
}

model Page {
  id                  String  @id @default(cuid())
  storyId             String
  story               Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  order               Int
  chapterTitle        String?
  text                String?
  illustrations       Json
  layout              String?
  illustrationPrompt  String?

  @@unique([storyId, order])
}

model Character {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId     String
  child       Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  source      CharacterSource @default(IMAGINED)
  name        String
  description String
  previewKey  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  stories Story[]
}

model StoryBlueprint {
  id              String    @id @default(cuid())
  name            String
  description     String
  type            StoryType
  systemPrompt    String
  coverImageKey   String?
  previewPageKeys String[]  @default([])
  createdById     String
  createdBy       User      @relation(fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stories Story[]
}

model Job {
  id        String    @id @default(cuid())
  storyId   String
  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  type      JobType
  status    JobStatus @default(PENDING)
  stage     String?
  error     String?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())
}

model Rating {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One rating per user per story — the upsert key.
  @@unique([storyId, userId])
}
