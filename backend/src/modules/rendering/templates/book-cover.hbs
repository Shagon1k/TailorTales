<style>
    .cover {
        width: 148mm;
        height: 210mm;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        background: #1a0a00;
    }
    .cover__image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .cover__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top,
            rgba(20, 8, 0, 0.85) 0%,
            rgba(20, 8, 0, 0.3) 50%,
            transparent 100%
        );
    }
    .cover__text {
        position: relative;
        z-index: 1;
        text-align: center;
        padding: 0 8mm 10mm;
        width: 100%;
    }
    .cover__title {
        font-family: 'Nunito', sans-serif;
        font-size: 22pt;
        font-weight: 700;
        color: #fdf6ec;
        line-height: 1.25;
        margin-bottom: 2mm;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    }
    .cover__subtitle {
        font-family: 'Nunito', sans-serif;
        font-size: 10pt;
        font-weight: 400;
        color: rgba(253, 246, 236, 0.8);
        letter-spacing: 0.05em;
    }
</style>

<div class='cover'>
    {{#if imageBase64}}
        <img class='cover__image' src='data:image/png;base64,{{imageBase64}}' alt='' />
    {{/if}}
    <div class='cover__overlay'></div>
    <div class='cover__text'>
        <div class='cover__title text-zone'>{{title}}</div>
        {{#if subtitle}}<div class='cover__subtitle text-zone'>{{subtitle}}</div>{{/if}}
    </div>
</div>