<style>
    .text-image {
        width: 148mm;
        height: 210mm;
        display: flex;
        flex-direction: column;
        background: #fdf6ec;
    }
    .text-image__content {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 8mm 10mm 5mm;
        overflow: hidden;
    }
    .text-image__chapter {
        font-family: 'Nunito', sans-serif;
        font-size: 8pt;
        font-weight: 700;
        color: #c26a2a;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 3mm;
    }
    .text-image__body {
        font-family: 'Literata', serif;
        font-size: 11pt;
        line-height: 1.65;
        color: #2d1a0e;
        font-style: italic;
        hyphens: auto;
        flex: 1;
        overflow: hidden;
    }
    .text-image__body::first-letter {
        font-size: 3.2em;
        font-style: normal;
        font-weight: 700;
        float: left;
        line-height: 0.8;
        margin-right: 2mm;
        margin-top: 0.5mm;
        color: #c26a2a;
    }
    .text-image__image {
        width: 100%;
        height: 100mm;
        flex-shrink: 0;
        overflow: hidden;
        background: #e8d8c4;
    }
    .text-image__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
</style>

<div class='text-image'>
    <div class='text-image__content'>
        {{#if chapterTitle}}<div class='text-image__chapter text-zone'>{{chapterTitle}}</div>{{/if}}
        <div class='text-image__body text-zone'>{{text}}</div>
    </div>
    <div class='text-image__image'>
        {{#if imageBase64}}
            <img src='data:image/png;base64,{{imageBase64}}' alt='' />
        {{/if}}
    </div>
</div>
