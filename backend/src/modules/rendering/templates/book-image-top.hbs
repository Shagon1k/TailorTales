<style>
    .image-top {
        width: 148mm;
        height: 210mm;
        display: flex;
        flex-direction: column;
        background: #fdf6ec;
    }
    .image-top__image {
        width: 100%;
        height: 92mm;
        flex-shrink: 0;
        overflow: hidden;
        background: #e8d8c4;
    }
    .image-top__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .image-top__content {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 7mm 10mm 7mm;
        overflow: hidden;
    }
    .image-top__chapter {
        font-family: 'Nunito', sans-serif;
        font-size: 8pt;
        font-weight: 700;
        color: #c26a2a;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 3mm;
    }
    .image-top__body {
        font-family: 'Literata', serif;
        font-size: 16pt;
        line-height: 1.5;
        color: #2d1a0e;
        hyphens: auto;
        flex: 1;
        overflow: hidden;
    }
    .image-top__body::first-letter {
        font-size: 3em;
        font-style: normal;
        font-weight: 700;
        float: left;
        line-height: 0.82;
        margin-right: 2mm;
        margin-top: 0.8mm;
        color: #c26a2a;
    }
</style>

<div class='image-top'>
    <div class='image-top__image'>
        {{#if imageBase64}}
            <img src='data:image/png;base64,{{imageBase64}}' alt='' />
        {{/if}}
    </div>
    <div class='image-top__content'>
        {{#if chapterTitle}}<div class='image-top__chapter text-zone'>{{chapterTitle}}</div>{{/if}}
        <div class='image-top__body text-zone'>{{text}}</div>
    </div>
</div>
