<html lang='{{lang}}'>
    <head>
        <meta charset='UTF-8' />
        <style>
            @page { size: 148mm 210mm; margin: 0; }

            @font-face {
              font-family: 'Nunito';
              font-weight: 400;
              font-style: normal;
              src: url('{{fontsDir}}/Nunito-400-latin.woff2') format('woff2');
                              unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
                                             U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
                                             U+2212, U+2215, U+FEFF, U+FFFD;
                            }
                            @font-face {
                              font-family: 'Nunito';
                              font-weight: 400;
                              font-style: normal;
                              src: url('{{fontsDir}}/Nunito-400-cyrillic.woff2') format('woff2');
                              unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
                            }
                            @font-face {
                              font-family: 'Nunito';
                              font-weight: 700;
                              font-style: normal;
                              src: url('{{fontsDir}}/Nunito-700-latin.woff2') format('woff2');
                              unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
                                             U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
                                             U+2212, U+2215, U+FEFF, U+FFFD;
                            }
                            @font-face {
                              font-family: 'Nunito';
                              font-weight: 700;
                              font-style: normal;
                              src: url('{{fontsDir}}/Nunito-700-cyrillic.woff2') format('woff2');
                              unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
                            }
                            @font-face {
                              font-family: 'Literata';
                              font-weight: 400;
                              font-style: normal;
                              src: url('{{fontsDir}}/Literata-400-latin.woff2') format('woff2');
                              unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
                                             U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
                                             U+2212, U+2215, U+FEFF, U+FFFD;
                            }
                            @font-face {
                              font-family: 'Literata';
                              font-weight: 400;
                              font-style: normal;
                              src: url('{{fontsDir}}/Literata-400-cyrillic.woff2') format('woff2');
                              unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
                            }
                            @font-face {
                              font-family: 'Literata';
                              font-weight: 700;
                              font-style: normal;
                              src: url('{{fontsDir}}/Literata-700-latin.woff2') format('woff2');
                              unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
                                             U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
                                             U+2212, U+2215, U+FEFF, U+FFFD;
                            }
                            @font-face {
                              font-family: 'Literata';
                              font-weight: 700;
                              font-style: normal;
                              src: url('{{fontsDir}}/Literata-700-cyrillic.woff2') format('woff2');
                              unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
                            }

                            *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

                            html, body {
                              width: 148mm;
                              height: 210mm;
                              overflow: hidden;
                              font-family: 'Literata', serif;
                              font-size: 11pt;
                              line-height: 1.6;
                              color: #2d1a0e;
                              background: #fdf6ec;
                            }

                            .page {
                              width: 148mm;
                              height: 210mm;
                              position: relative;
                              overflow: hidden;
                            }

                            /* Auto-fit safety net: clamp text that overflows its container */
                            .text-zone {
                              overflow: hidden;
                              word-break: break-word;
                            }{{#if watermark}}
                .watermark { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%)
                rotate(-32deg); display: flex; flex-direction: column; align-items: center; gap:
                0.08em; max-width: 112mm; font-family: 'Nunito', sans-serif; font-size: 34pt;
                font-weight: 700; color: rgba(45, 26, 14, 0.13); text-align: center; line-height:
                0.94; pointer-events: none; z-index: 9999; letter-spacing: 0.05em; text-transform:
                uppercase; }
                .watermark__line { white-space: nowrap; }
                .watermark__fox { display: inline-block; margin-left: 0.16em; filter: grayscale(1)
                brightness(0.2); opacity: 0.75; }
            {{/if}}
        </style>
    </head>
    <body>
        <div class='page'>
            {{{pageContent}}}
            {{#if watermark}}<div class='watermark'><span class='watermark__line'>TailorTales</span><span class='watermark__line'>Preview<span class='watermark__fox'>🦊</span></span></div>{{/if}}
        </div>
    </body>
</html>
