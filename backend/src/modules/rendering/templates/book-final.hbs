<style>
    .final {
        width: 148mm;
        height: 210mm;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 12mm 12mm;
        background: #fdf6ec;
        text-align: center;
        gap: 6mm;
    }
    .final__image {
        width: 40mm;
        height: 40mm;
        border-radius: 50%;
        overflow: hidden;
        background: #e8d8c4;
        flex-shrink: 0;
    }
    .final__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .final__closing {
        font-family: 'Literata', serif;
        font-size: 11pt;
        line-height: 1.7;
        color: #2d1a0e;
        max-height: 80mm;
        overflow: hidden;
    }
    .final__tagline {
        font-family: 'Nunito', sans-serif;
        font-size: 9pt;
        color: #c26a2a;
        letter-spacing: 0.05em;
        margin-top: 2mm;
    }
</style>

<div class='final'>
    {{#if imageBase64}}
        <div class='final__image'>
            <img src='data:image/png;base64,{{imageBase64}}' alt='' />
        </div>
    {{/if}}
    <div class='final__closing text-zone'>{{text}}</div>
    {{#if tagline}}<div class='final__tagline text-zone'>{{tagline}}</div>{{/if}}
</div>