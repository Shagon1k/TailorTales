# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tailortales?schema=public"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-jwt-secret"
JWT_EXPIRY_DAYS=7

# Backend URL — used to build OAuth callback URL
BACKEND_URL="http://localhost:3001"

# Frontend URL — used for post-OAuth redirect
FRONTEND_URL="http://localhost:3000"

# Storage — MinIO (dev) / AWS S3 (prod)
# Dev (MinIO via docker-compose):
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_FORCE_PATH_STYLE=true
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="tailortales"
# Prod (AWS S3): remove STORAGE_ENDPOINT and STORAGE_FORCE_PATH_STYLE; set real AWS credentials

# Redis — BullMQ queue
REDIS_URL="redis://localhost:6379"

# OpenRouter — text + image generation (single provider)
OPENROUTER_API_KEY="sk-or-..."
# Text model: Gemini 2.0 Flash — cost-effective, fast, strong RU support, JSON Schema structured output
OPENROUTER_TEXT_MODEL="google/gemini-2.0-flash-001"
# Image model: configurable — must support modalities:["image"] via OpenRouter
OPENROUTER_IMAGE_MODEL="google/gemini-flash-1.5-8b"
# Set to true in CI / local to skip real API calls and use stub responses
USE_AI_STUBS=false
