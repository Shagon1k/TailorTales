# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tailortales?schema=public"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-jwt-secret"
JWT_EXPIRY_DAYS=7

# Backend URL — used to build OAuth callback URL
BACKEND_URL="http://localhost:3001"

# Frontend URL — used for post-OAuth redirect
FRONTEND_URL="http://localhost:3000"

# Storage — MinIO (dev) / AWS S3 (prod)
# Dev (MinIO via docker-compose):
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_FORCE_PATH_STYLE=true
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="tailortales"
# Prod (AWS S3): remove STORAGE_ENDPOINT and STORAGE_FORCE_PATH_STYLE; set real AWS credentials
