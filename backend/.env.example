# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tailortales?schema=public"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# JWT — min 32 chars (e.g. `openssl rand -base64 48`)
JWT_SECRET=""
JWT_EXPIRY_DAYS=7
AUTH_ALLOWED_EMAILS=

# URLs
BACKEND_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# Redis — BullMQ queue
REDIS_URL="redis://localhost:6380"

# OpenRouter — text + image generation
OPENROUTER_API_KEY=""
OPENROUTER_TEXT_MODEL="google/gemini-2.0-flash"
OPENROUTER_IMAGE_MODEL="google/gemini-flash-1.5-8b"
# Set to true in CI / local to skip real AI API calls and use stub responses
USE_AI_STUBS=false
# Set to true to skip Resend and just log emails
USE_EMAIL_STUBS=false

# Resend — transactional email
RESEND_API_KEY=""
RESEND_FROM="TailorTales <stories@tailortales.app>"
# Where contact-form submissions are routed
CONTACT_INBOX_EMAIL=""

# Storage — MinIO (dev) / AWS S3 (prod)
# Dev (MinIO via docker-compose):
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_FORCE_PATH_STYLE=true
STORAGE_REGION="eu-west-1"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="tailortales"
# Prod (AWS S3): remove STORAGE_ENDPOINT and STORAGE_FORCE_PATH_STYLE; set real AWS credentials

# New Relic APM — agent loads only when NODE_OPTIONS is set (UAT/prod only)
# NODE_OPTIONS="--import newrelic/esm-loader.mjs"
NEW_RELIC_LICENSE_KEY=""
# NEW_RELIC_APP_NAME="TailorTales-UAT"   # or "TailorTales-Prod"

# Sentry — error tracking (disabled in dev; enabled on UAT/prod)
SENTRY_ENABLED=false
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="uat"   # or "production"

# Paddle — billing. With stubs on, the PADDLE_* keys may stay empty.
USE_PADDLE_STUBS=false
PADDLE_ENVIRONMENT="sandbox"
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
# Paddle catalog ids consumed by `pnpm seed:pricing-tiers`
PADDLE_PRODUCT_ID_STORY_HOUR=""
PADDLE_PRICE_ID_STORY_HOUR=""
PADDLE_PRODUCT_ID_FAMILY_WORKSHOP=""
PADDLE_PRICE_ID_FAMILY_WORKSHOP=""
