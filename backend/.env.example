# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tailortales?schema=public"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# JWT
JWT_SECRET=""
JWT_EXPIRY_DAYS=7

# URLs
BACKEND_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# Redis — BullMQ queue
REDIS_URL="redis://localhost:6379"

# OpenRouter — text + image generation
OPENROUTER_API_KEY=""
OPENROUTER_TEXT_MODEL="google/gemini-2.0-flash-001"
OPENROUTER_IMAGE_MODEL="google/gemini-flash-1.5-8b"
# Set to true in CI / local to skip real API calls and use stub responses
USE_AI_STUBS=false

# Resend — transactional email
RESEND_API_KEY=""
RESEND_FROM="TailorTales <stories@tailortales.app>"
# Where contact-form submissions are routed
CONTACT_INBOX_EMAIL=""

# Storage — MinIO (dev) / AWS S3 (prod)
# Dev (MinIO via docker-compose):
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_FORCE_PATH_STYLE=true
STORAGE_REGION="eu-west-1"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="tailortales"
# Prod (AWS S3): remove STORAGE_ENDPOINT and STORAGE_FORCE_PATH_STYLE; set real AWS credentials
