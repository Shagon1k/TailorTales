{
    "name": "backend",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "dev": "nest start --watch",
        "build": "nest build",
        "start": "node dist/main",
        "type-check": "tsc --noEmit",
        "lint": "eslint src/",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "db:generate": "prisma generate",
