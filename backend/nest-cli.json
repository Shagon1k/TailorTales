{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "deleteOutDir": true,
        "assets": [
            { "include": "modules/rendering/templates/**/*.hbs", "watchAssets": true },
            { "include": "modules/rendering/assets/**/*", "watchAssets": true }
        ]
    }
}
