# Copy these keys into the Dokploy Compose environment panel.
# This file shows UAT-shaped values. Replace every CHANGE_ME value.
# Production uses live domains/credentials/Paddle values and omits the two MinIO-only keys below.

# Public origins (no trailing slash)
BACKEND_URL=https://uat.tailortales.app/api
FRONTEND_URL=https://uat.tailortales.app

# Dokploy-managed PostgreSQL and Redis connection strings
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@POSTGRES_HOST:5432/CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@REDIS_HOST:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
# UAT only: comma-separated exact emails. Production: leave empty or omit.
AUTH_ALLOWED_EMAILS=CHANGE_ME
# UAT only: random secret shared with the GitHub Actions smoke workflow. Production: omit.
E2E_TEST_SECRET=CHANGE_ME

# OpenRouter
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_TEXT_MODEL=CHANGE_ME
OPENROUTER_IMAGE_MODEL=CHANGE_ME

# Resend
RESEND_API_KEY=CHANGE_ME
RESEND_FROM="TailorTales UAT <uat@tailortales.app>"
CONTACT_INBOX_EMAIL=CHANGE_ME

# UAT MinIO. The endpoint must be public because presigned URLs are opened by browsers.
# Production: omit STORAGE_ENDPOINT and STORAGE_FORCE_PATH_STYLE; use AWS values for the rest.
STORAGE_ENDPOINT=https://storage-uat.tailortales.app
STORAGE_FORCE_PATH_STYLE=true
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=tailortales-uat
NEXT_PUBLIC_STORAGE_URL=https://storage-uat.tailortales.app

# Paddle (sandbox for UAT, production for prod)
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=CHANGE_ME
PADDLE_WEBHOOK_SECRET=CHANGE_ME
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=CHANGE_ME
PADDLE_PRODUCT_ID_STORY_HOUR=CHANGE_ME
PADDLE_PRICE_ID_STORY_HOUR=CHANGE_ME
PADDLE_PRODUCT_ID_FAMILY_WORKSHOP=CHANGE_ME
PADDLE_PRICE_ID_FAMILY_WORKSHOP=CHANGE_ME

# Sentry (backend and frontend use different project DSNs)
SENTRY_DSN=https://CHANGE_ME
NEXT_PUBLIC_SENTRY_DSN=https://CHANGE_ME
SENTRY_ENVIRONMENT=uat
SENTRY_AUTH_TOKEN=CHANGE_ME

# New Relic
NEW_RELIC_LICENSE_KEY=CHANGE_ME
NEW_RELIC_APP_NAME=TailorTales-UAT

# Optional: leave empty on UAT; set the GA4 ID on production
NEXT_PUBLIC_GA_MEASUREMENT_ID=
